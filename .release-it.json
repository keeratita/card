{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}"
  },
  "github": {
    "release": true
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        "package.json",
        {
          "file": "src/core/adapters/base.ts",
          "type": "text/typescript"
        }
      ]
    }
  }
}