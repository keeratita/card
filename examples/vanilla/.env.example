# Environment variables for vanilla example
# Copy this file to .env and fill in your keys

# Stripe Public Key
# Get yours at: https://dashboard.stripe.com/test/apikeys
# ⚠️  Never expose secret keys (sk_...)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Omise Public Key
# Get yours at: https://dashboard.omise.co/test/apikeys
# ⚠️  Never expose secret keys (skey_...)
VITE_OMISE_PUBLIC_KEY=pkey_test_your_omise_public_key_here
